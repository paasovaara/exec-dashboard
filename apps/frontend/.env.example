# Quick start (any mode): copy to .env.local
# Prefer mode-specific files below so local vs remote stays clear.

VITE_USE_SUPABASE=true
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---
# Runtime targets (recommended):
#
# Local Supabase (npm run dev):
#   cp .env.development.example .env.development.local
#
# Remote Supabase (npm run build / preview):
#   cp .env.production.example .env.production.local
#
# See repo README for full setup of local and hosted projects.
