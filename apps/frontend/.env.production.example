# Used when you run: npm run build or npm run preview (Vite mode: production)
# Copy to apps/frontend/.env.production.local (same folder as vite.config.ts).
# Values override .env.local for production builds.
#
# Get URL and anon key from: Supabase Dashboard → Project Settings → API
# Project URL → VITE_SUPABASE_URL
# anon public   → VITE_SUPABASE_ANON_KEY

VITE_USE_SUPABASE=true
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=paste-anon-public-key-from-dashboard
